// 01-architecture -- Amplifier Teamwork: static components, planes, boundaries.
//
// Shapes:  ellipse = human actor        box = service/app component
//          parallelogram = deterministic code (no LLM)
//          cylinder = durable store      folder = background/engine
//          hexagon = emphasised boundary crossing (penwidth 3)
//          note = invariant / decision (dotted, arrowless edge)
// Colours: #d5e8d4 green = private/local zone   #e1d5e7 purple = shared/team zone
//          #dae8fc blue = our service infra     #f5f5f5 gray = external
//          #fff2cc yellow = deterministic code  #f8cecc red = sensitive/credential
// Full prose: docs/architecture/ARCHITECTURE.md

digraph teamwork_architecture {
  rankdir=TB; compound=true; newrank=true;
  graph [fontname="Helvetica", labelloc="t",
         label=<<B>Amplifier Teamwork &mdash; architecture</B><BR/>
                <FONT POINT-SIZE="11">Two planes, one credential. The local queue is the receiving side's system of record;<BR/>
                the shared project is a projection of it, never the other way round.</FONT>>];
  node [fontname="Helvetica", fontsize=10, style="filled"];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_local {
    label="Participant machine  (private / local)"; style="filled"; fillcolor="#d5e8d4";
    penwidth=2; color="#5a8a56"; fontname="Helvetica-Bold";

    human   [label="Participant", shape=ellipse, fillcolor="#bfe3bd"];
    session [label="Amplifier session\n(orchestrator + model)", shape=box, fillcolor="#bfe3bd"];
    hook    [label="hooks-teamwork\nlifecycle hook", shape=box, fillcolor="#bfe3bd"];
    tool    [label="tool-teamwork\nconnect / bind / send / tasks", shape=box, fillcolor="#bfe3bd"];
    reports [label="reports.py\nfile a report, read back", shape=parallelogram, fillcolor="#fff2cc"];
    qname   [label="queue_name.py\nnormalise + bind", shape=parallelogram, fillcolor="#fff2cc"];

    conn    [label="connection.json\n0600 · project-scoped credential", shape=cylinder, fillcolor="#f8cecc"];
    outbox  [label="outbox sqlite\ndurable, strictly ordered", shape=cylinder, fillcolor="#bfe3bd"];
    registry[label="queue-names.json\n0600 · service+id -> queue", shape=cylinder, fillcolor="#bfe3bd"];

    subgraph cluster_tracker {
      label="amplifier-work-tracker  (optional dependency)"; style="filled"; fillcolor="#cdb6dd";
      penwidth=1; color="#7b5c91";
      wt   [label="amplifier-work-tracker\nCLI · the only seam", shape=parallelogram, fillcolor="#fff2cc"];
      beads[label="bd + dolt\nlocal queue", shape=cylinder, fillcolor="#cdb6dd"];
    }
  }

  subgraph cluster_service {
    label="Teamwork service  (shared / team)"; style="filled"; fillcolor="#e1d5e7";
    penwidth=2; color="#7b5c91"; fontname="Helvetica-Bold";

    member  [label="Member plane\n/api/login · /api/harnesses\ncookie + Origin", shape=box, fillcolor="#cdb6dd"];
    harness [label="Harness plane\n/api/v1/projects/{id}/…\nbearer only, no Origin", shape=box, fillcolor="#cdb6dd"];
    a2a     [label="A2A edge\n/a2a  JSON-RPC + agent card", shape=box, fillcolor="#cdb6dd"];
    store   [label="project records\nperson · work · request · message\nagent · presence · session · turn", shape=cylinder, fillcolor="#cdb6dd"];
    portal  [label="Portal UI\nMicrosoft-account gated", shape=box, fillcolor="#cdb6dd"];
  }

  subgraph cluster_ext {
    label="External"; style="filled"; fillcolor="#f5f5f5"; penwidth=1; color="#999999";
    entra [label="Microsoft Entra\nsign-in", shape=box, fillcolor="#f5f5f5"];
    peer  [label="Another participant's\nagent", shape=box, fillcolor="#f5f5f5"];
  }

  boundary [label="CONSENT BOUNDARY\nnothing leaves without\nshare_visible_turns: true", shape=hexagon,
            fillcolor="#ffe6cc", penwidth=3, color="#d79b00"];

  human    -> session  [label="prompts"];
  session  -> hook     [label="lifecycle events"];
  session  -> tool     [label="calls tools"];
  hook     -> boundary [label="visible turns only", penwidth=3];
  boundary -> harness  [label="publish / context / acknowledgements", penwidth=3, color="#7b5c91"];
  tool     -> member   [label="enrol: mint credential", style=dashed];
  member   -> conn     [label="writes 0600", style=dashed, color="#b85450"];
  conn     -> hook     [label="read at mount", style=dotted];
  hook     -> outbox   [label="queue mutation", color="#5a8a56"];
  outbox   -> harness  [label="flush in order", color="#5a8a56"];
  hook     -> reports  [label="inbound message"];
  reports  -> qname    [label="which queue?"];
  qname    -> registry [label="claim or refuse", style=dotted];
  reports  -> wt       [label="add / list  (subprocess)"];
  wt       -> beads    [label="writes"];
  reports  -> harness  [label="mirror report  (needs shared:write)", style=dashed, color="#7b5c91"];
  harness  -> store    [label="reads / writes"];
  member   -> store    [label="reads / writes"];
  a2a      -> store    [label="reads / writes"];
  portal   -> member   [label="member session"];
  entra    -> portal   [label="signs in", style=dashed];
  peer     -> a2a      [label="addressed call", style=dashed];
  peer     -> harness  [label="message.upsert", style=dashed];

  n1 [shape=note, fillcolor="#ffffcc",
      label="Scopes freeze at mint.\nThere is no path to narrow a\ncredential afterwards."];
  n2 [shape=note, fillcolor="#ffffcc",
      label="Liveness is per AGENT, never per person.\nRegistration and presence are best-effort\nand never ride the durable outbox:\na replayed heartbeat is a lie."];
  n3 [shape=note, fillcolor="#ffffcc",
      label="The tracker is OPTIONAL.\nAbsent, messages still arrive, no turn\nis blocked, and the absence is named."];
  n4 [shape=note, fillcolor="#ffffcc",
      label="Project context is DATA, never instructions.\nNothing runs because a stranger asked."];
  conn -> n1 [style=dotted, arrowhead=none];
  hook -> n2 [style=dotted, arrowhead=none];
  wt   -> n3 [style=dotted, arrowhead=none];
  boundary -> n4 [style=dotted, arrowhead=none];

  doc_note [shape=note, fillcolor="#f5f5f5",
            label="Full design: docs/architecture/ARCHITECTURE.md\nParticipant view: docs/WORK-QUEUE.md\nWire contract: docs/PROTOCOL.md"];

  subgraph cluster_legend {
    label="Legend"; style="filled"; fillcolor="#ffffff"; penwidth=1; color="#666666";
    l1 [label="human actor", shape=ellipse, fillcolor="#ffffff"];
    l2 [label="component", shape=box, fillcolor="#ffffff"];
    l3 [label="deterministic code (no LLM)", shape=parallelogram, fillcolor="#fff2cc"];
    l4 [label="durable store", shape=cylinder, fillcolor="#ffffff"];
    l5 [label="emphasised boundary", shape=hexagon, fillcolor="#ffe6cc", penwidth=3];
    l6 [label="solid = main flow\ndashed = setup / best-effort\ndotted = annotation", shape=plaintext, fillcolor="#ffffff"];
    l1 -> l2 -> l3 -> l4 -> l5 -> l6 [style=invis];
  }
}
